mapscripts RadiantBunker_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: RadiantBunker_OnTransition
    MAP_SCRIPT_ON_RESUME: RadiantBunker_OnResume
    }

const FLAG_GENERATOR_ON = 0x22
const FLAG_HIDE_STARTER_BAG = 0x20

script RadiantBunker_OnTransition {
    if (flag(FLAG_GENERATOR_ON)) {
    setflashlevel(0)
    setmetatile(4, 9, 0x2E7, 0)
    setmetatile(5, 9, 0x2E7, 0)
    setmetatile(6, 9, 0x2E7, 0)
    setmetatile(4, 10, 0x2E6, 0)
    setmetatile(5, 10, 0x2E6, 0)
    setmetatile(6, 10, 0x2E6, 0)
    }
    else {
        setflashlevel(7)
    }

    if (flag(FLAG_HIDE_STARTER_BAG)) {
        removeobject(1)
    }

}

script RadiantBunker_OnResume {
    if (flag(FLAG_GENERATOR_ON)) {
    setmetatile(4, 9, 0x2E7, 0)
    setmetatile(5, 9, 0x2E7, 0)
    setmetatile(6, 9, 0x2E7, 0)
    setmetatile(4, 10, 0x2E6, 0)
    setmetatile(5, 10, 0x2E6, 0)
    setmetatile(6, 10, 0x2E6, 0)
    }

}

script RadiantBunker_EventScript_Password{
    lockall
    msgbox(Computer, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES){
        special(EnterCode)
        waitstate
        special(GetPasswordFeedback)
        if (var(VAR_RESULT) == 1){
        setflag(FLAG_PASSWORD_ENTERED)
        msgbox("Password successfully entered.")    
        }
        releaseall
        end
    }
    else{
    releaseall
    end
    }
}


script RadiantBunker_EventScript_Starter{

    lockall
    msgbox(StarterChoice, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_PICHU_SPIKY_EARED, 5, ITEM_NONE, move1=MOVE_TAIL_WHIP, move2=MOVE_THUNDERSHOCK, move3=MOVE_SWEET_KISS, move4=MOVE_WISH)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            msgbox("You received a pichu and the bag.")
            removeobject(1)
            setflag(FLAG_HIDE_STARTER_BAG)
            setflag(FLAG_SYS_BAG_GET)
            setflag(FLAG_SYS_POKEMON_GET)
            setflag(FLAG_SYS_B_DASH)
            call(NicknamePichu)
            }
        end}

    else{
        msgbox(Starter_NotChosen)
        waitmessage
        releaseall
        end
        }

}

script RadiantBunker_EventScript_Generator{
    lockall
    if(flag(FLAG_HIDE_STARTER_BAG) == FALSE){
        msgbox("It's a generator.
        It does not seem to be powered.")
        releaseall
        end
    } elif(flag(FLAG_GENERATOR_ON) == FALSE){
        msgbox(PowerGenerator, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
		    dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Tail Whip", "Thundershock", "Sweet Kiss", "Wish")
            if (var(VAR_RESULT) == 0){
				msgbox("Pichu whipped the generator with its\n"
				"tail.\p"
                "The generator seems unimpressed.")
				}
			elif (var(VAR_RESULT) == 2){
				msgbox("Pichu gave the generator a little kiss.\p"
				"Although flattered, the generator\n" 
				"remains off.")
				}
			elif (var(VAR_RESULT) == 3){
				msgbox("Pichu wished for the generator to turn\n"
                "on.\p"
                "Unfortunately, Jirachi did not hear it.")
				}
			elif (var(VAR_RESULT) == 1){
                delay(16)
                playmoncry (SPECIES_PICHU, CRY_MODE_NORMAL)
                waitmoncry
                delay(16)
                playse(SE_M_THUNDERBOLT)
                delay(16)
                msgbox(UseThundershock)
                animateflash(0)
                setflashlevel(0)
                setmetatile(4, 9, 0x2E7, 0)
                setmetatile(5, 9, 0x2E7, 0)
                setmetatile(6, 9, 0x2E7, 0)
                setmetatile(4, 10, 0x2E6, 0)
                setmetatile(5, 10, 0x2E6, 0)
                setmetatile(6, 10, 0x2E6, 0)
                special(DrawWholeMapView)
                setflag(FLAG_GENERATOR_ON)
            }

        }
    releaseall
    end
    }

}

text PowerGenerator{
    "It's an unpowered generator.
    Have Pichu use a move?"
}

text UseThundershock{
    "Pichu powered up the generator with\n"
    "Thundershock!"
}

text StarterChoice{
    "There's a pokeball in the bag. 
    Take it?"
}

script NicknamePichu{
    msgbox("Give Pichu a nickname?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    else{setflag(FLAG_REMOVE_WARP_FADE)
        warpsilent(MAP_RADIANT_BUNKER, 1, 7)
        waitstate
        releaseall
        end
    }

}

script NicknameBoxMon{

    msgbox("Give Pichu a nickname?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameReceivedBoxMon)
    }
    msgbox("Pichu was transferred to the PC.")

}

text Starter_NotChosen{
    "You decided to leave it."
}

text Computer{
    "Teleporter Status: Off\n"
    "Underpass Passage: Closed\p"
    "Enter password?"
}

text Correct_Password{
    "Eternity"
}
