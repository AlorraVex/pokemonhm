	msgbox Route114_Text_KaiPostBattle, MSGBOX_AUTOCLOSE
	end

Route114_Text_AllMyMonDoesIsRoarTakeThis:
	.string "All my POKéMON does is ROAR…\n"
	.string "No one dares to come near me…\p"
	.string "Sigh… If you would, please take\n"
	.string "this TM away…$"

Route114_Text_ExplainRoar:
	.string "TM05 contains ROAR.\n"
	.string "A ROAR sends POKéMON scurrying.$"

Route114_Text_Poochyena:
	.string "Bow! Bowwow!$"

Route114_Text_MeteorFallsSign:
	.string "METEOR FALLS\n"
	.string "RUSTBORO CITY THROUGH HERE$"

Route114_Text_FossilManiacsHouseSign:
	.string "FOSSIL MANIAC'S HOUSE\n"
	.string "“Fossils gratefully accepted!”$"

Route114_Text_LanettesHouse:
	.string "LANETTE'S HOUSE$"

`



script Route114_EventScript_FirstFreezeDry {
	lock
	if (flag (FLAG_FREEZE_DRY_DISCOVERED) == FALSE){
		setvar(VAR_TEMP_0, SPECIES_EEVEE)
		specialvar(VAR_RESULT, CheckLeadMonSpecies)
		if  (var(VAR_RESULT) == TRUE){
			msgbox("The water here is icy.\n" 
			"Have Eevee use a move?")
			dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Mirror Move", "Helping Hand", "Bite", "Freeze Dry")
			if (var(VAR_RESULT) == 0){
				msgbox("Eevee used the water's reflection to do\n"
				"its hair.")
				}
			elif (var(VAR_RESULT) == 1){
				msgbox("Eevee used the Help action. You\n"
				"gain advantage on your next d20 test!\l") 
				}
			elif (var(VAR_RESULT) == 2){
				msgbox("Eevee bites the water.\n"
				"The water does not respond.")
				}
			elif (var(VAR_RESULT) == 3){
			delay(16)
			playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
			delay(16)
			setmetatile(12, 13, 0x135, 0)
       		setmetatile(11, 13, 0x135, 0)
        	setmetatile(10, 13, 0x135, 0)
        	setmetatile(9, 13, 0x135, 0)
        	special(DrawWholeMapView)
			delay(16)
			setflag (FLAG_TEMP_1)
			setflag (FLAG_FREEZE_DRY_DISCOVERED)
			msgbox("Eevee made a bridge with Freeze Dry!")
			}

			else{ 
			msgbox ("It didn't seem to have any effect.")
			}
		}
	
		else {msgbox ("The water here is icy.\n"
		"A pokemon may be able to freeze it.")

		}

	} 

	else{
		if(flag (FLAG_TEMP_1) == FALSE){
			checkspecies(SPECIES_EEVEE)
			if(var(VAR_RESULT) == TRUE){
			msgbox(MakeBridgeEevee, MSGBOX_YESNO)
				if(var(VAR_RESULT) == YES){
					delay(16)
					playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
					delay(16)
					setmetatile(12, 13, 0x135, 0)
       				setmetatile(11, 13, 0x135, 0)
        			setmetatile(10, 13, 0x135, 0)
        			setmetatile(9, 13, 0x135, 0)
        			special(DrawWholeMapView)
					delay(16)
					setflag (FLAG_TEMP_1)
				}
			}

		}

		else{
			if(flag (FLAG_TEMP_1) == FALSE){
				checkspecies(SPECIES_GLACEON)
				if(var(VAR_RESULT) == TRUE){
					bufferleadmonspeciesname (0)
					msgbox(MakeBridgeGlaceon, MSGBOX_YESNO)
					if(var(VAR_RESULT) == YES){
					delay(16)
					playmoncry (SPECIES_GLACEON, CRY_MODE_NORMAL)
					delay(16)
					setmetatile(12, 13, 0x135, 0)
					setmetatile(11, 13, 0x135, 0)
					setmetatile(10, 13, 0x135, 0)
					setmetatile(9, 13, 0x135, 0)
					special(DrawWholeMapView)
					delay(16)
					setflag (FLAG_TEMP_1)
					}
				}

			}

			else{
			if(flag (FLAG_TEMP_1) == FALSE){
				msgbox ("The water here is icy.\n"
				"A pokemon may be able to freeze it.")
				}
			
			}

		}

	}

	releaseall
	end

}

