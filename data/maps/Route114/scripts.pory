mapscripts Route114_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route114_OnTransition
    MAP_SCRIPT_ON_RESUME: Route114_OnResume
    }

const FLAG_BERRY_GARDEN_OPEN = 0x29
const FLAG_NOIBAT_BERRY = 0x2B
const FLAG_NOIBAT_OBTAINED = 0x2A

script Route114_OnTransition{
	if(flag(FLAG_BERRY_GARDEN_OPEN)){
	setmetatile(30, 39, 0x001, 0)
	setmetatile(30, 38, 0x133, 1)
	}

	if(flag(FLAG_NOIBAT_BERRY) == TRUE && flag(FLAG_NOIBAT_OBTAINED) == FALSE){
		setobjectxyperm(LOCALID_NOIBAT, 20, 62)
	}

	if(flag(FLAG_TEMP_1) == TRUE){
		setobjectxyperm(LOCALID_DRAGONSTATUE1, 5, 48)
	}

}

script Route114_OnResume{
	if(flag(FLAG_BERRY_GARDEN_OPEN)){
	setmetatile(30, 39, 0x001, 0)
	setmetatile(30, 38, 0x133, 1)
	}

	if(flag(FLAG_NOIBAT_BERRY) == TRUE && flag(FLAG_NOIBAT_OBTAINED) == FALSE){
		setobjectxyperm(LOCALID_NOIBAT, 20, 62)
	}

	if(flag(FLAG_TEMP_1) == TRUE){
		setobjectxyperm(LOCALID_DRAGONSTATUE1, 5, 48)
	}

}

script EventScript_CreateIceBridge{
	lockall
	checkspecies(SPECIES_EEVEE)
		if(var(VAR_RESULT) == TRUE){
			msgbox(MakeBridgeEevee, MSGBOX_YESNO)
			if(var(VAR_RESULT) == YES){
				delay(16)
				playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
				waitmoncry
				delay(8)
				playse(SE_M_BLIZZARD2)
				delay(16)
				callnative(CreateIceBridge)
				delay(16)
			}
		}
		
	else{
		checkspecies(SPECIES_GLACEON)
		if(var(VAR_RESULT) == TRUE){
			msgbox(MakeBridgeGlaceon, MSGBOX_YESNO)
			if(var(VAR_RESULT) == YES){
				delay(16)
				playmoncry (SPECIES_GLACEON, CRY_MODE_NORMAL)
				waitmoncry
				delay(8)
				playse(SE_M_BLIZZARD2)
				delay(16)
				callnative(CreateIceBridge)
				delay(16)
			}
		}

	}

	releaseall
	end
	
}

script EventScript_WaterIsIcy{
	lock
	msgbox("The water here is icy.")
	release
	end
}

script Route114_EventScript_FirstFreezeDry {
	lock
	if (flag (FLAG_FREEZE_DRY_DISCOVERED) == FALSE){
		setvar(VAR_TEMP_0, SPECIES_EEVEE)
		specialvar(VAR_RESULT, CheckLeadMonSpecies)
		if  (var(VAR_RESULT) == TRUE){
			msgbox("The water here is icy.\n" 
			"Have Eevee use a move?")
			dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Mirror Move", "Helping Hand", "Bite", "Freeze Dry")
			if (var(VAR_RESULT) == 0){
				msgbox("Eevee used the water's reflection to do\n"
				"its hair.")
				}
			elif (var(VAR_RESULT) == 1){
				msgbox("Eevee used the Help action. You\n"
				"gain advantage on your next d20 test!") 
				}
			elif (var(VAR_RESULT) == 2){
				msgbox("Eevee bit the water.\n"
				"The water did not respond.")
				}
			elif (var(VAR_RESULT) == 3){
			delay(16)
			playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
			waitmoncry
			delay(8)
			playse(SE_M_BLIZZARD2)
			delay(16)
			setmetatile(12, 13, 0x135, 0)
       		setmetatile(11, 13, 0x135, 0)
        	setmetatile(10, 13, 0x135, 0)
        	setmetatile(9, 13, 0x135, 0)
			setflag (FLAG_FREEZE_DRY_DISCOVERED)
			removeobject(6)
        	special(DrawWholeMapView)
			delay(16)
			msgbox("Eevee made a bridge with Freeze Dry!")
			}

			else{ 
			msgbox ("It didn't seem to have any effect.")
			}
		}
	
		else {msgbox ("The water here is icy.")

		}

	} 

	releaseall
	end

}

//bridge 1

script Route114_Trigger_Bridge1Surf {

	lockall
	setvar(VAR_ICE_BRIDGE_X, 11)
	setvar(VAR_ICE_BRIDGE_Y, 13)
	specialvar(VAR_RESULT, IsBridgeBuilt)
	if(var(VAR_RESULT) == TRUE) {
		setmetatile(12, 13, 0x135, 1)
   		setmetatile(11, 13, 0x135, 1)
    	setmetatile(10, 13, 0x135, 1)
    	setmetatile(9, 13, 0x135, 1)
	}
		else{
			setmetatile(12, 13, 0x1B6, 0)
    		setmetatile(11, 13, 0x000, 0)
			setmetatile(10, 13, 0x000, 0)
			setmetatile(9, 13, 0x1A2, 0)
		}

	special(DrawWholeMapView)
	releaseall
	end

}

script Route114_Trigger_Bridge1Land {

	lockall
	releaseall
	end

}

//bridge 2

