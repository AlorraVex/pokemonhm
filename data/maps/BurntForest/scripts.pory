}

movement TrainerFindLeft{
    walk_right
    walk_up
    walk_up
    walk_up
    face_left
    delay_16
}

movement TrainerFindRight{
    walk_left
    walk_up
    walk_up
    walk_right
    walk_up
    face_left
    delay_16
}

movement PlayerShiftLeft{
    walk_up
    delay_16
}

movement PlayerShiftRight{
    walk_left
    walk_up
    delay_16
}

movement Ghost{
    emote_exclamation_mark
    delay_16
    delay_16
    delay_16
    delay_16
    face_right
    delay_16
    delay_16
    face_left
    delay_16
    delay_16
    face_up
    delay_16
    delay_16
    jump_in_place_up
    delay_8
    jump_in_place_up
    delay_8
    jump_in_place_up
    delay_16
    delay_16
}

movement EeveeJoin{
    walk_down
    face_left
}

movement EeveeShift{
    walk_down
}

movement BlockExit{
    walk_right
}


text TakeBall{
    "It's an abandoned pokeball.\n"
    "Take it?"
}

text LeftBall{
    "You decide to leave it."
}

text EeveeBallUse{
    "It's a strange, blue eevee.\p"
    "Even through the heat of the forest,\n" 
    "cold air radiates off it.\p"
    "Show Eevee the pokeball?"
}

script BurntForest_EventScript_EeveeFollow{
    lockall
    faceplayer
    msgbox("Eevee is following you cautiously.")
    waitmessage
    releaseall
    end

}

script BurntForest_EventScript_EeveeTrainer{
    lockall
    if (flag(FLAG_EEVEE_OBTAINED)){
    msgbox("It's Eevee's original trainer.")
    waitmessage
    releaseall
    end}

    else{
    msgbox("A pokemon trainer, succumbed to the\n"
    "oppressive heat of the forest.\p"
    "He is not breathing.")
    waitmessage
    releaseall
    end} 

}

script NicknameEevee{
    msgbox("Give Eevee a nickname?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    else{
        releaseall
        end
    }

}