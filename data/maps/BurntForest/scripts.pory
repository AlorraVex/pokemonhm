mapscripts BurntForest_MapScripts {}

const FLAG_EEVEE_BALL_TAKEN = 0x21
const FLAG_EEVEE_FOLLOWING = 0x25

script BurntForest_EventScript_Ball{

    lockall
    msgbox(TakeBall, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        msgbox("You take the pokeball. 
        It is cold to the touch.")
        additem(ITEM_POKE_BALL)
        setflag(FLAG_EEVEE_BALL_TAKEN)
        removeobject(1)
        waitmessage
        releaseall
        end}

    else{
        msgbox(LeftBall)
        waitmessage
        releaseall
        end
        }

}

script BurntForest_EventScript_Eevee{

    lockall
    faceplayer
    if (flag(FLAG_EEVEE_BALL_TAKEN)){
        msgbox(EeveeBallUse, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            msgbox("At the sight of the ball, Eevee's\n"
            "ears perk up.\p"
            "It begins to follow you.")
            setfollowernpc (2 0x0 BurntForest_EventScript_EeveeFollow)
            setvar (0x40F7, 1)
            removeobject (0)
            setflag(FLAG_EEVEE_FOLLOWING)
            releaseall
            }

        else{
            releaseall
            }

        end
        }

    else{
        msgbox("It's a strange, blue eevee.\p" 
        "You try to approach, but it shies\n"
        "away from you.")
        waitmessage
        releaseall
        end
        }

}

script BurntForest_Trigger_BlockExit{
    lockall
    hidefollowernpc
    msgbox("Eevee doesn't seem ready to leave\n"
    "the forest yet.")
    applymovement(OBJ_EVENT_ID_PLAYER, BlockExit)
    waitmovement (0)
    releaseall
}

script BurntForest_EeeveeTrainerSceneLeft{
    lockall
    applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, TrainerFindLeft)
    waitmovement (0)
    applymovement (OBJ_EVENT_ID_PLAYER, PlayerShiftLeft)
    waitmovement
    playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
    waitmoncry
    delay(16)
    msgbox("Upon seeing its former trainer,\n"
    "Eevee's ears fall low.\p"
    "Eevee gives its trainer and nudge, then\n" 
    "settles down beside him.")
    waitmessage
    waitbuttonpress
    closemessage
    delay(16)
    delay(16)
    delay(16)
    delay(16)
    playse(SE_PIN)
    delay(8)
    applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, Ghost)
    waitmovement (0)
    delay(16)
    delay(16)
    msgbox("Although you don't hear anything,\n"
    "Eevee's ears twitch as if it is listening\l"
    "to something.")
    waitmessage
    waitbuttonpress
    closemessage
    delay(16)
    delay(16)
    delay(16)
    delay(16)
    applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, EeveeJoin)
    waitmovement (0)
    delay(16)
    delay(16)
    delay(16)
    msgbox("Eevee looks at the empty pokeball in\n"
    "your hand.\p"
    "It seems like it wants to join you.")
    delay(16)
    playmoncry (SPECIES_EEVEE, CRY_MODE_NORMAL)
    waitmoncry
    delay(16)
    destroyfollowernpc
    setvar (0x40F7, 0)
    removeitem(ITEM_POKE_BALL)
    setflag (FLAG_EEVEE_OBTAINED)
    givemon(SPECIES_EEVEE, 5, ITEM_NONE, move1=MOVE_MIRROR_MOVE, move2=MOVE_HELPING_HAND, move3=MOVE_BITE, move4=MOVE_FREEZE_DRY)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Eevee joined the party!")
    call(NicknameEevee)
    end
}

