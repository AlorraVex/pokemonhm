mapscripts DesertUnderPass_MapScripts {}

script DesertUnderpass_EventScript_Starter{

    lockall
    msgbox(StarterChoice, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_PICHU, 5, ITEM_NONE)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("You recieved a Pichu and the Bag.")
            removeobject(1)
            setflag(FLAG_HIDE_STARTER_BAG)
            setflag(FLAG_SYS_BAG_GET)
            setflag(FLAG_SYS_POKEMON_GET)
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Pichu was sent to the PC.")
            removeobject(1)
            call(NicknameBoxMon)
        }
        else{
            msgbox("You don't have room.")
        }
    }
    else{
        msgbox(Starter_NotChosen)
    }
    waitmessage
    releaseall
    end

}

script DesertUnderpass_EventScript_Generator{
    lockall
    msgbox(PowerGenerator, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        msgbox(UseThundershock)
        EventScript_UseFlash
        animate flash 1
        setflashlevel 1
    }
    releaseall
    end
    

}

text PowerGenerator{
    ("Pichu wants to use Thundershock. \p 
    Let it?")
}

script UseThundershock{
    if(var(VAR_RESULT) == YES)
    msgbox("Pichu powered up the generator \n
    with Thundershock.")
}

text StarterChoice{
    ("There's a Pokeball in the bag. \p 
    Take it?")
}

script NicknamePartyMon{
    msgbox("Give Pichu a nickname?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameRecievedPartyMon)
    }

}

script NicknameBoxMon{

    msgbox("Give Pichu a nickname?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameRecievedBoxMon)
    }
    msgbox("Pichu was transferred to the PC.")

}

text Starter_NotChosen{
    "You decided to leave it."
}

